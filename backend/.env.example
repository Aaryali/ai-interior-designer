# =========================================================
# Forma Backend - Environment Variables (example)
# Copy this file to ".env" and fill in real values locally.
# NEVER commit a real .env file with secrets.
# =========================================================

# --- API ---
API_PREFIX=/api
PROJECT_NAME=Forma Backend
ENVIRONMENT=development

# --- Frontend / CORS ---
# Comma-separated list of allowed origins for the Next.js frontend
FRONTEND_URL=http://localhost:3000

# --- Database ---
# Intended production database is PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/forma
# During local development, leaving this blank falls back to a local
# SQLite database file so the project runs without a live Postgres instance.
DATABASE_URL=

# --- Storage ---
# Local filesystem path used to store uploaded room images during
# early development. This will later be swapped for cloud object
# storage (S3 / Supabase Storage) via the storage abstraction layer.
# Note: room images are saved under a "rooms" subdirectory inside this
# path (see app/services/room_service.py), so this should point at the
# storage root, not the rooms/ folder itself.
STORAGE_PATH=../storage

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=15
